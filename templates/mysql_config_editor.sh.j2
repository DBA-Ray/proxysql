#!/usr/bin/expect -f
# {{ ansible_managed }}
set timeout 30
log_user 0
spawn /usr/bin/mysql_config_editor set --login-path=proxysql --host=127.0.0.1 -P {{ admin_login_port | default(6032) }} --user=admin --password
expect -re {(?i)enter password}
send -- "{{ admin_login_password }}\r"
expect {
    -re {(?i)continue} { send -- "y\r" }
    eof {}
}
expect eof

